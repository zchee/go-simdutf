{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-schema-v1.json",
  "$comment": "Runtime-only relational checks: authority bytes/digest, exact frozen binding and command/output origin path, typed tuple semantic fields and nested members, receipt formula, proof receipt lookup/order/kind/subject, registry uniqueness and state ordering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","key_kind","storage_id","display_id","tuple_hex","family_id","campaign_id","lane_id","producer_id","provider","kind","path","origin_path","media_type","size","digest","source_commit","source_tree","source_parent","source_role","source_dirty","origin_campaign_id","origin_producer_id","origin_source_commit","origin_source_tree","origin_source_parent","row_id","cell_id","symbol_id","batch_id","transaction_id","operation_id","backend","direct_symbol","ordered_members","state_subject","prerequisite_state","current_state","disposition","go_qualification","initial_state","proof_receipt_ids","na_reason","na_source","identity_value","identity_set_digest","command_digest","qualification_contract_id","qualification_contract_digest","corpus_id","corpus_digest","host_receipt_id","authority_sha256","host_receipt_digest","command_id","command_ordinal","command_action","command_role","output_id","receipt_id"],
  "properties": {
    "schema":{"const":"simdutf-port-evidence-v1"}, "version":{"const":1},
    "key_kind":{"enum":["row","cell","symbol","batch","transaction"]}, "storage_id":{"pattern":"^(rk|cell|symbol|batch|transaction)-v1-[0-9a-f]{64}$"}, "display_id":{"type":"string"}, "tuple_hex":{"pattern":"^[0-9a-f]+$"},
    "family_id":{"pattern":"^family-v1-[0-9a-f]{64}$"}, "campaign_id":{"pattern":"^campaign-v1-[0-9a-f]{64}$"}, "lane_id":{"enum":["darwin-arm64-nosimd","darwin-arm64-simd-negative","linux-amd64-none","linux-amd64-simd","linux-riscv64-compile","linux-s390x-compile"]}, "producer_id":{"$ref":"#/$defs/part"}, "provider":{"$ref":"#/$defs/part"},
    "kind":{"enum":["identity","stdout","stderr","exit","argv-env","test","race","fuzz","object","disassembly","benchmark","incumbent-benchmark","candidate-benchmark","benchstat","provider-guard","selector","final-selector","state-transition","not-applicable","index","quiet-affinity"]}, "path":{"type":"string"}, "origin_path":{"type":"string","minLength":1}, "media_type":{"type":"string","minLength":1}, "size":{"type":"integer","minimum":0,"maximum":268435456}, "digest":{"$ref":"#/$defs/digest"},
    "source_commit":{"$ref":"#/$defs/git"}, "source_tree":{"$ref":"#/$defs/git"}, "source_parent":{"$ref":"#/$defs/git"}, "source_role":{"$ref":"#/$defs/part"}, "source_dirty":{"const":false}, "origin_campaign_id":{"pattern":"^campaign-v1-[0-9a-f]{64}$"}, "origin_producer_id":{"$ref":"#/$defs/part"}, "origin_source_commit":{"$ref":"#/$defs/git"}, "origin_source_tree":{"$ref":"#/$defs/git"}, "origin_source_parent":{"$ref":"#/$defs/git"},
    "row_id":{"pattern":"^rk-v1-[0-9a-f]{64}$"}, "cell_id":{"pattern":"^(|cell-v1-[0-9a-f]{64})$"}, "symbol_id":{"pattern":"^(|symbol-v1-[0-9a-f]{64})$"}, "batch_id":{"pattern":"^(|batch-v1-[0-9a-f]{64})$"}, "transaction_id":{"pattern":"^transaction-v1-[0-9a-f]{64}$"}, "operation_id":{"pattern":"^op-v1-[0-9a-f]{64}$"}, "backend":{"type":"string"}, "direct_symbol":{"type":"string"}, "ordered_members":{"type":"array","items":{"type":"string"}},
    "state_subject":{"enum":["none","row","backend_cell"]}, "prerequisite_state":{"type":"string"}, "current_state":{"type":"string"}, "disposition":{"enum":["","selected","direct_only","not_applicable"]}, "go_qualification":{"enum":["","pass","fail","inconclusive"]}, "initial_state":{"enum":["snapshot_planned","eligible"]}, "proof_receipt_ids":{"type":"array","items":{"pattern":"^receipt-v1-[0-9a-f]{64}$"},"uniqueItems":true}, "na_reason":{"type":"string"}, "na_source":{"type":"string"}, "identity_value":{"type":"string"}, "identity_set_digest":{"$ref":"#/$defs/digest"},
    "command_digest":{"$ref":"#/$defs/digest"}, "qualification_contract_id":{"$ref":"#/$defs/part"}, "qualification_contract_digest":{"$ref":"#/$defs/digest"}, "corpus_id":{"$ref":"#/$defs/part"}, "corpus_digest":{"$ref":"#/$defs/digest"}, "host_receipt_id":{"$ref":"#/$defs/part"}, "authority_sha256":{"$ref":"#/$defs/digest"}, "host_receipt_digest":{"$ref":"#/$defs/digest"}, "command_id":{"$ref":"#/$defs/part"}, "command_ordinal":{"type":"integer","minimum":1}, "command_action":{"$ref":"#/$defs/part"}, "command_role":{"$ref":"#/$defs/part"}, "output_id":{"$ref":"#/$defs/part"}, "receipt_id":{"pattern":"^receipt-v1-[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if":{"properties":{"state_subject":{"const":"none"}}},"then":{"properties":{"prerequisite_state":{"const":""},"current_state":{"const":""},"disposition":{"const":""},"go_qualification":{"const":""},"proof_receipt_ids":{"maxItems":0},"na_reason":{"const":""},"na_source":{"const":""}}}},
    {"if":{"properties":{"state_subject":{"const":"row"}}},"then":{"properties":{"kind":{"const":"state-transition"},"prerequisite_state":{"enum":["snapshot_planned","scalar_private","scalar_green","family_published"]},"current_state":{"enum":["scalar_private","scalar_green","family_published","complete"]}}}},
    {"if":{"properties":{"current_state":{"const":"not_applicable"}}},"then":{"properties":{"kind":{"const":"not-applicable"},"state_subject":{"const":"backend_cell"},"disposition":{"const":"not_applicable"},"proof_receipt_ids":{"maxItems":0}}}}
  ],
  "$defs":{"part":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"git":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
