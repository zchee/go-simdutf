{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualification-contract-schema-v1.json",
  "title": "simdutf qualification contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "qualification_contract_id",
    "family_contract_id",
    "scalar_publication_commit",
    "scalar_publication_tree",
    "scalar_publication_parent",
    "policy_sha256",
    "classification_sha256",
    "benchmark_source_sha256",
    "benchmark_order_sha256",
    "corpus_contract_sha256",
    "providers",
    "old_sample_count",
    "new_sample_count",
    "sample_order",
    "required_allocs_per_op",
    "minimum_bulk_win_bps",
    "maximum_protected_slowdown_bps",
    "maximum_p_value_millionths",
    "no_statistically_significant_slowdown",
    "inconclusive_outcome",
    "failure_outcome",
    "selected_outcome",
    "required_evidence_kinds",
    "rows",
    "no_accelerated_operations"
  ],
  "properties": {
    "schema": {"const": "simdutf-qualification-contract-v1"},
    "version": {"const": 1},
    "qualification_contract_id": {"type": "string", "pattern": "^qualification-v1-[0-9a-f]{64}$"},
    "family_contract_id": {"enum": ["FC-v1-helper-validation", "FC-v1-latin1-source", "FC-v1-utf8-source", "FC-v1-utf16-source", "FC-v1-utf32-source", "FC-v1-detection", "FC-v1-find", "FC-v1-base64"]},
    "scalar_publication_commit": {"$ref": "#/$defs/gitObject"},
    "scalar_publication_tree": {"$ref": "#/$defs/gitObject"},
    "scalar_publication_parent": {"$ref": "#/$defs/gitObject"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "classification_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_source_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_order_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_contract_sha256": {"$ref": "#/$defs/sha256"},
    "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["westmere", "haswell", "archsimd", "neon"]}},
    "old_sample_count": {"const": 10},
    "new_sample_count": {"const": 10},
    "sample_order": {"const": "old_then_new"},
    "required_allocs_per_op": {"const": 0},
    "minimum_bulk_win_bps": {"const": 300},
    "maximum_protected_slowdown_bps": {"const": 200},
    "maximum_p_value_millionths": {"const": 50000},
    "no_statistically_significant_slowdown": {"const": true},
    "inconclusive_outcome": {"const": "direct_only"},
    "failure_outcome": {"const": "direct_only"},
    "selected_outcome": {"const": "selected"},
    "required_evidence_kinds": {"const": ["incumbent-benchmark", "candidate-benchmark", "benchstat", "provider-guard", "selector", "final-selector"]},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "no_accelerated_operations": {"type": "array", "items": {"$ref": "#/$defs/noAcceleratedOperation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "runtime_identifiers"],
      "properties": {
        "tier": {"enum": ["scalar", "westmere", "haswell", "archsimd", "neon"]},
        "runtime_identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "operation_ordinal", "operation_id", "public_wrapper", "benchmark_name",
        "corpus_ordinal", "corpus_id", "corpus_byte_length", "corpus_sha256",
        "corpus_source_identity", "corpus_materialization", "validity_class", "class",
        "input_unit", "size_units", "set_bytes_denominator", "options_id", "options_tuple_hex",
        "destination_policy", "result_sink", "setup_boundary", "timed_boundary", "protected",
        "intended_bulk", "tiers", "go_dispatch_status", "pinned_cpp_status", "pinned_cpp_reason",
        "pinned_cpp_procedure", "pinned_cpp_options", "row_digest"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "operation_ordinal": {"type": "integer", "minimum": 1},
        "operation_id": {"type": "string", "pattern": "^op-v1-[0-9a-f]{64}$"},
        "public_wrapper": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "benchmark_name": {"type": "string", "pattern": "^BenchmarkDispatchQualification/[A-Z][A-Za-z0-9_]*/Q-[A-Za-z0-9-]+/(short|boundary|bulk)/[0-9]{4,}$"},
        "corpus_ordinal": {"type": "integer", "minimum": 1},
        "corpus_id": {"type": "string", "pattern": "^Q-[A-Za-z0-9-]+$"},
        "corpus_byte_length": {"type": "integer", "minimum": 1},
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_source_identity": {"type": "string", "minLength": 1},
        "corpus_materialization": {"type": "string", "minLength": 1},
        "validity_class": {"enum": ["valid", "invalid", "mixed", "option_dependent"]},
        "class": {"enum": ["short", "boundary", "bulk"]},
        "input_unit": {"enum": ["byte", "uint16", "uint32"]},
        "size_units": {"type": "integer", "minimum": 1},
        "set_bytes_denominator": {"type": "integer", "minimum": 1},
        "options_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "options_tuple_hex": {"type": "string", "pattern": "^(?:[0-9a-f]{2})+$"},
        "destination_policy": {"enum": ["none", "preallocated_exact", "preallocated_safe", "reset_each_iteration"]},
        "result_sink": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "setup_boundary": {"const": "outside_timed_loop"},
        "timed_boundary": {"const": "public_wrapper_only"},
        "protected": {"type": "boolean"},
        "intended_bulk": {"type": "boolean"},
        "tiers": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/tier"}},
        "go_dispatch_status": {"const": "required_pending"},
        "pinned_cpp_status": {"enum": ["comparable_pass", "comparable_result_only", "not_comparable", "not_applicable"]},
        "pinned_cpp_reason": {"type": "string"},
        "pinned_cpp_procedure": {"type": "string"},
        "pinned_cpp_options": {"type": "string"},
        "row_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "noAcceleratedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_ordinal", "operation_id", "public_wrapper", "status"],
      "properties": {
        "operation_ordinal": {"type": "integer", "minimum": 1},
        "operation_id": {"type": "string", "pattern": "^op-v1-[0-9a-f]{64}$"},
        "public_wrapper": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "status": {"const": "not_applicable_no_accelerated_cell"}
      }
    }
  }
}
