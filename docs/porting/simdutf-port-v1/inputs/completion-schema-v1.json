{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "completion-schema-v1.json",
  "title": "simdutf port completion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_commit",
    "source_tree",
    "source_parent",
    "source_clean",
    "authority_sha256",
    "frozen_input_sha256",
    "classification_sha256",
    "qualification_sha256",
    "manifest_sha256",
    "corpus_sha256",
    "raw_return_index_sha256",
    "official_backends_sha256",
    "official_hosts_sha256",
    "official_apis_sha256",
    "implemented",
    "planned",
    "excluded",
    "rows"
  ],
  "properties": {
    "schema": {"const": "simdutf-port-completion-v1"},
    "version": {"const": 1},
    "source_commit": {"$ref": "#/$defs/gitObject"},
    "source_tree": {"$ref": "#/$defs/gitObject"},
    "source_parent": {"$ref": "#/$defs/gitObject"},
    "source_clean": {"const": true},
    "authority_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_input_sha256": {"$ref": "#/$defs/sha256"},
    "classification_sha256": {"$ref": "#/$defs/sha256"},
    "qualification_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "raw_return_index_sha256": {"$ref": "#/$defs/sha256"},
    "official_backends_sha256": {"$ref": "#/$defs/sha256"},
    "official_hosts_sha256": {"$ref": "#/$defs/sha256"},
    "official_apis_sha256": {"$ref": "#/$defs/sha256"},
    "implemented": {"const": 155},
    "planned": {"const": 0},
    "excluded": {"const": 9},
    "rows": {"type": "array", "minItems": 125, "maxItems": 125, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "receipt": {"type": "string", "pattern": "^receipt-v1-[0-9a-f]{64}$"},
    "evidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "identity_set_digest", "command_manifest_sha256", "qualification_contract_id", "qualification_contract_sha256", "corpus_id", "corpus_sha256", "host_receipt_id", "host_receipt_sha256"],
      "properties": {
        "campaign_id": {"type": "string", "pattern": "^campaign-v1-[0-9a-f]{64}$"},
        "identity_set_digest": {"$ref": "#/$defs/sha256"},
        "command_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "qualification_contract_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "host_receipt_id": {"type": "string", "pattern": "^host-v1-[0-9a-f]{64}$"},
        "host_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_key_v1", "manifest_ordinal", "go_symbol", "scalar_batch_storage_id", "api_transaction_storage_id", "state", "evidence_context", "receipt_ids", "cells"],
      "properties": {
        "row_key_v1": {"type": "string", "pattern": "^rk-v1-[0-9a-f]{64}$"},
        "manifest_ordinal": {"type": "integer", "minimum": 1, "maximum": 125},
        "go_symbol": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
        "scalar_batch_storage_id": {"type": "string", "pattern": "^batch-v1-[0-9a-f]{64}$"},
        "api_transaction_storage_id": {"type": "string", "pattern": "^transaction-v1-[0-9a-f]{64}$"},
        "state": {"const": "complete"},
        "evidence_context": {"$ref": "#/$defs/evidenceContext"},
        "receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt"}},
        "cells": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "cell_storage_id",
        "outcome",
        "state",
        "direct_symbol",
        "direct_symbol_storage_id",
        "kernel_batch_storage_id",
        "evidence_batch_storage_id",
        "qualification",
        "disposition",
        "na_reason",
        "na_source",
        "evidence_context",
        "receipt_ids"
      ],
      "properties": {
        "backend": {"enum": ["westmere", "haswell", "archsimd", "neon"]},
        "cell_storage_id": {"type": "string", "pattern": "^cell-v1-[0-9a-f]{64}$"},
        "outcome": {"enum": ["eligible", "not_applicable"]},
        "state": {"enum": ["not_applicable", "selected", "direct_only"]},
        "direct_symbol": {"type": "string"},
        "direct_symbol_storage_id": {"type": "string", "pattern": "^(|symbol-v1-[0-9a-f]{64})$"},
        "kernel_batch_storage_id": {"type": "string", "pattern": "^(|batch-v1-[0-9a-f]{64})$"},
        "evidence_batch_storage_id": {"type": "string", "pattern": "^(|batch-v1-[0-9a-f]{64})$"},
        "qualification": {"enum": ["", "pass", "fail", "inconclusive"]},
        "disposition": {"enum": ["not_applicable", "selected", "direct_only"]},
        "na_reason": {"type": "string"},
        "na_source": {"type": "string"},
        "evidence_context": {"$ref": "#/$defs/evidenceContext"},
        "receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/receipt"}}
      }
    }
  }
}
